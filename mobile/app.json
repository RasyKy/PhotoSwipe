{
  "expo": {
    "name": "PhotoSwipe",
    "slug": "photoswipe",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.photoswipe"
    },
    "android": {
      "package": "com.anonymous.photoswipe",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {},
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow PhotoSwipe to access your photos to help you clean up your library.",
          "savePhotosPermission": "Allow PhotoSwipe to save photos to your library."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "b3356a01-9142-4da6-8c2d-0165651cf274"
      }
    }
  }
}
